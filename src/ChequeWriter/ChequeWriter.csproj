<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ChequeWriter.app.ico" />
    <!-- Cheque pictures shown in the preview and on plain-paper test prints -->
    <EmbeddedResource Include="Images\*.jpg" LogicalName="RAKSpecial.Images.%(Filename).jpg" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChequeWriter.Core\ChequeWriter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>ChequeWriter</RootNamespace>
    <AssemblyName>RAKSpecial</AssemblyName>
    <Product>RAK Special</Product>
    <AssemblyTitle>RAK Special - RAK Bank cheque printing</AssemblyTitle>
    <Version>2.1.0</Version>
    <Company>Karthick Raja</Company>
    <Copyright>Copyright (c) 2026 Karthick Raja</Copyright>
    <Description>RAK Special: prints RAK Bank Business (RAK-001) and RAK Old (RAK-002) cheques with amount in words, fils, PDC series, register and payee list.</Description>
  </PropertyGroup>

</Project>
